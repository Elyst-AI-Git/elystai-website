# The contact form emails each enquiry to the team through Resend (https://resend.com).
# Until both of these are set, the contact form shows a "we are
# working on this, contact us directly" notice instead of accepting input.
EMAIL_API_KEY=
# A sender on a domain verified in Resend (SPF and DKIM), for example: Elyst AI <hello@elystai.com>
LEADS_FROM=
# Where enquiries go. Defaults to info@elystai.com.
LEADS_TO=
